LOG_LEVEL=info

# === DB ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# === JWT ===
SECRET_KEY=super-secret-key-change-me

# === RabbitMQ ===
RABBIT_USER=app
RABBIT_PASSWORD=app

# === Public / delivery ===
PUBLIC_HOST=192.168.1.12
PUBLIC_HTTP_SCHEME=http
PUBLIC_HTTP_PORT=8080
PUBLIC_RTMP_PORT=1935

DELIVERY_MODE=local
DELIVERY_BASE_URL=http://origin
DELIVERY_PUBLIC_BASE_URL=http://127.0.0.1:8080

# === HLS ===
HLS_TOKEN_SECRET=stage-secret-key
HLS_TOKEN_TTL_SECONDS=300

# === Live URLs ===
LIVE_RTMP_URL_TEMPLATE=rtmp://192.168.1.12:1935/live/{stream_key}
LIVE_HLS_URL_TEMPLATE=http://127.0.0.1:8080/live/{stream_key}/master.m3u8

# === CORS ===
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# === App env ===
APP_ENV=stage
LIVE_ENABLED=false
COMPOSE_PROFILE=demo