LOG_LEVEL=debug

PUBLIC_HOST=192.168.1.12
PUBLIC_HTTP_SCHEME=http
PUBLIC_HTTP_PORT=8080
PUBLIC_RTMP_PORT=1935

DELIVERY_MODE=local
DELIVERY_BASE_URL=http://origin
DELIVERY_PUBLIC_BASE_URL=http://127.0.0.1:8080

HLS_TOKEN_SECRET=dev-secret-key
HLS_TOKEN_TTL_SECONDS=300

LIVE_TTL_INTERVAL_SECONDS=10
LIVE_TTL_BATCH_SIZE=100

RABBIT_EVENTS_EXCHANGE=video.events.x
RABBIT_EVENTS_QUEUE=events.q
RABBIT_EVENTS_ROUTING_KEY=video.events

CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

APP_ENV=dev
LOG_LEVEL=debug
LIVE_ENABLED=true
COMPOSE_PROFILE=full