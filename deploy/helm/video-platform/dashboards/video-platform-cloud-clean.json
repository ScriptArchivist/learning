    },

    {
      "id": 3,
      "type": "stat",
      "title": "frontend",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [{ "expr": "max(up{job=\"frontend\"})", "instant": true, "refId": "A" }],
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 }
