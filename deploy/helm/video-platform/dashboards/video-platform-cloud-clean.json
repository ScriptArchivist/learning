    { "id": 1, "type": "row", "title": "Service Health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },

    {
      "id": 2,
      "type": "stat",
      "title": "Targets UP",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(up{job=~\"frontend|identity-service|upload-service|video-api|processing-worker|outbox-publisher|video-events-consumer|rabbitmq|postgres-exporter|prometheus|loki|alertmanager\"})", "instant": true, "refId": "A" }],
